{
  "name": "obsidian-structural-tables",
  "version": "0.6.2",
  "description": "Render semantic Markdown tables with merged cells, multi-row headers, and row headers in Obsidian.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm run build:bundle && npm run check:production",
    "build:bundle": "node esbuild.config.mjs production",
    "check:runtime": "node scripts/check-runtime.mjs",
    "format:check": "node scripts/check-format.mjs",
    "check:readme-i18n": "node scripts/check-readme-i18n.mjs",
    "check:docs-i18n": "node scripts/check-docs-i18n.mjs",
    "lint": "eslint main.ts src tests scripts esbuild.config.mjs eslint.config.mjs vitest.config.mts --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "node scripts/clean.mjs",
    "clean:deps": "node scripts/clean.mjs --deps",
    "check:production": "node scripts/check-production-bundle.mjs",
    "release:validate": "node scripts/release.mjs validate",
    "release:validate-tag": "node scripts/release.mjs validate-tag",
    "release:bundle": "node scripts/release.mjs bundle",
    "release:verify-source": "node scripts/release.mjs verify-source",
    "release:verify-transport": "node scripts/release.mjs verify-transport",
    "release:publish-github": "node scripts/release.mjs publish-github-event",
    "release:post-verify": "node scripts/release.mjs post-verify",
    "check": "npm run check:runtime && npm run format:check && npm run check:readme-i18n && npm run check:docs-i18n && npm run lint && npm run typecheck && npm run test:coverage && npm run check:coverage-scope && npm run build:bundle && npm run check:production && npm run release:validate",
    "release:check": "npm run check && npm run release:validate-tag",
    "check:coverage-scope": "node scripts/check-coverage-scope.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "markdown",
    "tables",
    "rowspan",
    "colspan"
  ],
  "author": "ZhengYX",
  "license": "MIT",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.2",
    "markdown-it": "14.3.2",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "obsidian": {
      "moment": "2.31.0"
    },
    "@codemirror/state": "$@codemirror/state"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "yaml": "2.9.1"
  }
}
